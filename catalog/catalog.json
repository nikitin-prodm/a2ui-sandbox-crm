  "nestingRules": [
    {
      "parent": "EntityCard",
      "forbiddenChildren": [
        "TrendChart",
        "AlertBanner"
      ]
    }
  ],
  "rendererSemantics": {
    "$comment": "Renderer-side conventions: NOT part of the A2UI 0.9.1 protocol; implemented by our Compose renderer + CatalogValidator. Declared here so the agent-facing contract and the renderer stay in sync.",
    "defaultActions": {
      "rule": "If a component omits 'action', the renderer injects the default action with context taken from the component's own props.",
      "examples": [
        "ActionItem without action -> event completeTask with context.taskId = props.taskId",
        "EntityCard without action -> event openEntity with context.entityType = props.entityType, context.entityId = props.entityId",
        "PipelineStrip without action -> event filterStage with context.stage = props.selectedStage"
      ]
    },
    "placeholders": {
      "rule": "The string '<this X>' inside an action context value is replaced at render time with the value of props[X] of the component that owns the action. This is a renderer convention; the A2UI protocol does not define it.",
      "example": "ActionItem action {\"event\":{\"name\":\"completeTask\",\"context\":{\"taskId\":\"<this taskId>\"}}} -> context.taskId resolved from props.taskId before dispatch"
    },
    "nestingConstraints": {
      "rule": "Component nesting constraints are enforced by the CatalogValidator BEFORE rendering, not by the UI.",
      "constraints": [
        {
          "forbidden": "TrendChart inside EntityCard (EntityCard is a leaf with fixed layout)"
        },
        {
          "forbidden": "AlertBanner inside EntityCard"
        }
      ],
      "how": "Tree traversal from root: walk updateComponents.components from the component with id 'root' following children ids (adjacency-list), maintaining a stack of ancestor types; for each component check nestingConstraints; violation -> error NESTING_NOT_ALLOWED with path /updateComponents/components/<id>/component and the parent chain in context."
    }
  },
  "actions": {
    "$comment": "Whitelist of event names the renderer may dispatch; each maps to a CRMRepository method or navigation. The agent cannot invent actions.",
    "navigate": {
      "context": {
        "route": "enum: home|pipeline|settings"
      }
    },
    "openEntity": {
      "context": {
        "entityType": "enum: contact|company|opportunity|task",
        "entityId": "string"
      }
    },
    "createTask": {
      "context": {
        "title": "string",
        "dueAt": "ISO-8601 optional",
        "contactId": "string optional"
      },
      "repositoryMapping": "CRMRepository.createTask (crm_repository.dart:65)"
    },
    "completeTask": {
      "context": {
        "taskId": "string"
      },
      "repositoryMapping": "CRMRepository.updateTask(completed=true) (crm_repository.dart:72)"
    },
    "updateOpportunityStage": {
      "context": {
        "opportunityId": "string",
        "stage": "string"
      },
      "repositoryMapping": "extension: updateOpportunityStage (Domain Extension Spec)"
    },
    "createNote": {
      "context": {
        "contactId": "string",
        "body": "string"
      },
      "repositoryMapping": "CRMRepository.createNote (crm_repository.dart:55)"
    },
    "triggerWorkflow": {
      "context": {
        "workflowId": "string",
        "recordId": "string"
      },
      "repositoryMapping": "CRMRepository.triggerWorkflow (crm_repository.dart:87)"
    },
    "refreshSurface": {
      "context": {
        "surfaceId": "string"
      }
    },
    "filterStage": {
      "context": {
        "stage": "string"
      },
      "notes": "local: updates data model selection, no repository call"
    }
  },
  "validationErrors": {
    "$comment": "Structured errors reported back to the agent so it can self-correct (mirrors A2uiException: code + message + context.path).",
    "envelope": {
      "code": "VALIDATION_FAILED",
      "fields": [
        "message",
        "context.path",
        "context.error",
        "context.allowedValues",
        "context.hint"
      ]
    },
    "errors": {
      "UNKNOWN_COMPONENT": {
        "trigger": "component name not in nativeComponents nor components",
        "report": {
          "allowedValues": "all catalog type names"
        }
      },
      "MISSING_REQUIRED_PROPERTY": {
        "trigger": "required property absent",
        "report": {
          "property": "name"
        }
      },
      "INVALID_PROPERTY_VALUE": {
        "trigger": "value outside enum / range / format",
        "report": {
          "allowedValues": "enum",
          "expected": "type or format"
        }
      },
      "PROPERTY_NOT_ALLOWED": {
        "trigger": "property not declared in the component schema (unevaluatedProperties:false semantics)"
      },
      "ACTION_NOT_ALLOWED": {
        "trigger": "action name outside whitelist or functionCall used",
        "report": {
          "allowedValues": "actions"
        }
      },
      "UNSUPPORTED_RENDERER_TYPE": {
        "trigger": "type is valid per the 0.9.1 basic catalog but marked not_implemented_v1 in this renderer (Image, Tabs, Modal, Video, AudioPlayer, TextField, CheckBox, ChoicePicker, Slider, DateTimeInput)",
        "report": {
          "hint": "This component type is deferred; use the budgeted catalog types (see rendererSupport) or a dedicated flow instead"
        },
        "distinction": "different from UNKNOWN_COMPONENT: the type exists in the spec but this renderer cannot draw it yet"
      },
      "NESTING_NOT_ALLOWED": {
        "trigger": "a component appears inside a forbidden parent (see top-level nestingRules)",
        "report": {
          "path": "/updateComponents/components/<id>/component",
          "ancestors": "the parent type chain from root"
        }
      },
      "LENGTH_LIMIT_EXCEEDED": {
        "trigger": "array length or string maxLength exceeded"
      }
    },
    "feedbackLoop": {
      "maxRetries": 2,
      "onExhausted": "render EmptyState with plain-language message + suggestion; keep previous valid surface if any"
    }
  },
  "dataModelPaths": {
    "$comment": "Convention for updateDataModel payloads per role screen (values always come from CRMRepository, never hardcoded by the agent).",
    "managerHome": [
